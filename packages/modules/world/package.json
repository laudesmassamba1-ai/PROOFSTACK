{
  "name": "@proofstack/module-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "WORLD — global software compatibility testing: identity, phone, address, currency, date/time and collation checks against a real product surface.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "profiles",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "@proofstack/core": "workspace:*",
    "@proofstack/engine": "workspace:*",
    "libphonenumber-js": "1.13.16"
  }
}
