{
  "name": "proofcore",
  "version": "0.1.0",
  "private": true,
  "description": "PROOFCORE — integrated software quality and reliability suite: WORLD (global compatibility), FLOW (transaction reliability), EXIT (data portability).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "node tooling/scripts/build.mjs && pnpm -r --filter ./apps/web build",
    "build:packages": "node tooling/scripts/build.mjs",
    "typecheck": "node tooling/scripts/build.mjs --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "web:dev": "pnpm --filter @proofcore/web dev",
    "dev:stack": "node tooling/scripts/dev-stack.mjs",
    "api:dev": "pnpm --filter @proofcore/api dev",
    "cli": "node packages/cli/dist/index.js",
    "proofcore": "node packages/cli/dist/index.js",
    "cli:package": "node tooling/scripts/package-cli.mjs",
    "cli:install": "pnpm cli:package && node tooling/scripts/install-cli.mjs",
    "cli:publish": "pnpm cli:package && node tooling/scripts/publish-cli.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cli:binary": "node tooling/scripts/build-binary.mjs",
    "cli:binary:all": "node tooling/scripts/build-binary.mjs --all",
    "cli:installers": "node tooling/scripts/build-installers.mjs",
    "cli:installers:all": "node tooling/scripts/build-installers.mjs --all",
    "app:desktop": "pnpm --filter @proofcore/desktop start",
    "app:dist": "pnpm build:packages && pnpm --filter @proofcore/web build && node tooling/scripts/package-desktop.mjs",
    "app:dist:linux": "pnpm build:packages && pnpm --filter @proofcore/web build && pnpm --filter @proofcore/desktop dist:linux",
    "app:dist:win": "pnpm build:packages && pnpm --filter @proofcore/web build && pnpm --filter @proofcore/desktop dist:win",
    "cloud:deploy": "node tooling/scripts/deploy-cloudflare.mjs",
    "cloud:deploy:api": "node tooling/scripts/deploy-cloudflare.mjs --only api",
    "cloud:deploy:web": "node tooling/scripts/deploy-cloudflare.mjs --only web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.2",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "playwright"
    ]
  }
}
