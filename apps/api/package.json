{
  "name": "@proofcore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROOFCORE API: accounts, workspaces, projects, reports, usage and billing. Runs on Cloudflare Workers (D1) and on Node 22 (SQLite) for local development.",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx/esm src/node.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "node --experimental-sqlite --import tsx/esm src/migrate.ts --local",
    "db:migrate:remote": "wrangler d1 migrations apply proofcore --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^2.0.1",
    "@proofcore/adapter-payments": "workspace:*",
    "@proofcore/adapter-reporting": "workspace:*",
    "@proofcore/billing": "workspace:*",
    "@proofcore/contracts": "workspace:*",
    "@proofcore/core": "workspace:*",
    "@proofcore/engine": "workspace:*",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@hono/node-server": "1.19.6",
    "@types/node": "22.19.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.46.0"
  }
}
