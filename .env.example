# Copy to .env.local. Never commit real credentials.
# Web: leave empty in production when `/api/*` is proxied by the same origin.
VITE_API_URL=http://localhost:8787

# API (apps/api). Secrets belong in the host secret store, not in this file.
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
# SASPAY_API_KEY=
# SASPAY_WEBHOOK_SECRET=
# Optional n8n observer for verified payment events (never payment authority)
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
